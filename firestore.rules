rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /hydra_memory/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /hydra_remediation_proposals/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /hydra_agent_status/{doc} {
      allow read: if true;
     allow write: if false;
    }
  }
}