# Copier en .env pour le développement local — ne jamais commiter le vrai .env

GCP_PROJECT_ID=ton-project-id
BOX_ROLE=scout
GEMINI_MODEL=gemini-2.0-flash
HYDRA_RING_HMAC_KEY=genere-avec-openssl-rand-hex-32

# En local uniquement — sur Cloud Run, l'auth se fait via le service account
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
